APP_NAME="XA"
SCHEME="XA"
TARGETS="XA:com.gios.xa,XACapture:com.gios.xa.capture,XAControl:com.gios.xa.control"
THIRD_PARTY_CONTENT="true"
# The Xcode 27 image: Xcode 27.1 is the first that builds for iPhone Duo's full screens.
RUNNER="xcode-27"
XCODE="27.1"
# StoreKit's local test store hangs on this image's simulator (iOS 27.0 under Xcode 27.1): the
# purchase test never returns. It runs from Xcode.
SKIP_TESTS="XATests/TipJarTests/testTipsLoadAndATipGoesThrough"
# Lines the film tests print about each emulated stock.
LOG_MATCH="CUBE got|DEVELOP "
# Live as soon as App Review approves it.
AUTO_RELEASE="true"
